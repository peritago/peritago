# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git 에 올라가지 않습니다.

# OpenAI API 키
OPENAI_API_KEY=

# translate 응답 생성기 전환 스위치
#   미설정(기본) : Mock 생성기 사용 — 키 없이도 개발 가능
#   false        : OpenAI 실연동 (OPENAI_API_KEY 필요)
PERITAGO_TRANSLATE_MOCK_GENERATOR=true

# 위키 검색(RAG) 전환 스위치 — 정웅기 WikiSearcher 구현 전까지 Mock 유지
PERITAGO_TRANSLATE_MOCK_WIKI=true
