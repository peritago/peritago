# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git 에 올라가지 않습니다.
#
# application.yml 의 spring.config.import: optional:file:.env[.properties] 로 읽히므로
# 이 파일은 "환경변수"가 아니라 "properties 파일"로 해석된다.
# 따라서 스프링 프로퍼티는 UPPER_SNAKE 가 아니라 점 표기로 써야 인식된다.
# (OPENAI_API_KEY 는 application.yml 이 ${OPENAI_API_KEY} 로 그 이름 그대로 참조해서 예외)

OPENAI_API_KEY=

# translate 응답 생성기 전환 스위치
#   미설정(기본) : Mock 생성기 사용 - 키 없이도 개발 가능
#   false        : OpenAI 실연동 (OPENAI_API_KEY 필요)
peritago.translate.mock.generator=true

# 위키 검색 전환 스위치 - 실제 WikiSearcher 구현이 붙으면 false
peritago.translate.mock.wiki=true
